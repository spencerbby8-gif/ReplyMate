<?xml version="1.0" encoding="utf-8"?>
<!-- P-splash-auth-polish: a soft diagonal light band that sweeps the icon once.
     Edges are fully transparent so the band is only visible mid-sweep; it lives
     inside the rounded-clipped icon frame. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="20"
        android:startColor="#00FFFFFF"
        android:centerColor="#5CFFFFFF"
        android:endColor="#00FFFFFF" />
</shape>
