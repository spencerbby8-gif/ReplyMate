<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/back_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="‹"
            android:textColor="@color/accent"
            android:textSize="28sp"
            android:paddingRight="12dp"
            android:paddingLeft="4dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/conv_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/conv_rel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_dim"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/audit_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Audit"
            android:textColor="@color/accent"
            android:textSize="14sp"
            android:padding="8dp" />

        <TextView
            android:id="@+id/edit_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Edit"
            android:textColor="@color/accent"
            android:textSize="14sp"
            android:padding="8dp" />
    </LinearLayout>

    <EditText
        android:id="@+id/conv_search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="6dp"
        android:hint="@string/conv_search_hint"
        android:textColorHint="@color/text_dim"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:background="@drawable/bg_field"
        android:padding="8dp"
        android:singleLine="true"
        android:inputType="text" />

    <ScrollView
        android:id="@+id/conv_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingLeft="16dp"
        android:paddingRight="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/msg_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/drafts_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="AI drafts"
                android:textColor="@color/text_dim"
                android:textSize="13sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/draft_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/gen_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingBottom="4dp"
        android:textColor="@color/accent"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/card"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom">

            <EditText
                android:id="@+id/msg_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Type your reply…"
                android:textColorHint="@color/text_dim"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:background="@drawable/bg_field"
                android:padding="12dp"
                android:minLines="1"
                android:maxLines="5"
                android:gravity="center_vertical|left"
                android:inputType="textMultiLine|textCapSentences" />

            <!-- P-intelligence-4: the Send arrow sits DIRECTLY beside the field,
                 like a normal chat app. Manual text still goes through the same
                 approval-free-but-direct channel: a valid quick-reply target gets
                 a straight delivery attempt, otherwise honest Copy + Open. -->
            <Button
                android:id="@+id/btn_manual"
                android:layout_width="56dp"
                android:layout_height="48dp"
                android:layout_marginLeft="8dp"
                android:text="➤"
                android:contentDescription="Send"
                android:textSize="18sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_gen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="✨ Generate an AI draft (you approve before sending)"
            android:textSize="12sp" />

        <!-- P-intelligence-14: INTENTIONAL generation — the owner picks the
             intention (follow-up / clarify / continue / opener); the same reply
             pipeline composes it; the result is still an approve-first draft. -->
        <Button
            android:id="@+id/btn_intent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="＋ Intentional draft: follow-up · clarify · continue · opener"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>
