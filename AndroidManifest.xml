<?xml version="1.0" encoding="utf-8"?>
<!-- ReplyMate manifest — P2. Delta per BLUEPRINT §8: NotificationListenerService
     (read-only) + POST_NOTIFICATIONS (our own draft alerts, runtime-gated on 33+). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.replymate.app">

    <!-- AI provider calls today; Supabase REST later (foundation phase). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- For OUR OWN "new message" pings (Android 13+ runtime grant). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Android 11+ package visibility: without these entries the OS makes
         getPackageInfo()/getLaunchIntentForPackage() pretend the app is absent,
         which broke Sources detection + deep-link fallback on real devices.
         Entries mirror the WatchedApps catalog ONLY (guarded by ManifestCatalogTest);
         com.android.vending so the official store page opens for missing apps. -->
    <queries>
        <package android:name="com.whatsapp" />
        <package android:name="org.telegram.messenger" />
        <package android:name="org.thoughtcrime.securesms" />
        <package android:name="com.google.android.apps.messaging" />
        <package android:name="com.facebook.orca" />
        <package android:name="com.Slack" />
        <package android:name="com.discord" />
        <package android:name="com.instagram.android" />
        <package android:name="com.x.android" />
        <package android:name="com.twitter.android" />
        <package android:name="com.zhiliaoapp.musically" />
        <package android:name="com.android.vending" />
    </queries>

    <application
        android:name=".ReplyMateApp"
        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher"
        android:theme="@style/ReplyMateTheme"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".ui.SplashActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.HomeActivity"
            android:exported="true" />

        <activity
            android:name=".ui.AuthActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="replymate" android:host="auth" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.OnboardingActivity" android:exported="false" />

        <activity android:name=".ui.SettingsActivity" android:exported="false" />
        <activity android:name=".ui.ProfileActivity" android:exported="false" />
        <activity android:name=".ui.VoiceActivity" android:exported="false" />
        <activity android:name=".ui.ProviderActivity" android:exported="false" />
        <activity android:name=".ui.ProviderEditActivity" android:exported="false" />
        <activity android:name=".ui.ContactEditActivity" android:exported="false" />
        <activity android:name=".ui.ConversationActivity" android:exported="false" />
        <activity android:name=".ui.DraftEditActivity" android:exported="false" />
        <activity android:name=".ui.SourcesActivity" android:exported="false" />
        <activity android:name=".ui.UsageActivity" android:exported="false" />
        <activity android:name=".ui.PromptAuditActivity" android:exported="false" />

        <!-- Read-only notification listener. The signature-level
             BIND_NOTIFICATION_LISTENER_SERVICE permission means ONLY the system
             can bind this service, even though it is exported. -->
        <service
            android:name=".listener.RmNotificationListener"
            android:label="ReplyMate listener"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- P-background: assistant notification buttons. Internal explicit
             broadcasts only — non-exported, no filters, nothing from outside. -->
        <receiver
            android:name=".assistant.AssistantReceiver"
            android:exported="false" />

    </application>
</manifest>
